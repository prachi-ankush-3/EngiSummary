# Gemini API Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# Frontend Configuration
FRONTEND_URL=http://localhost:3000

# File Upload Configuration
MAX_FILE_SIZE_MB=25
UPLOAD_DIR=uploads
OUTPUT_DIR=outputs

# Material Properties
STEEL_DENSITY=7850

# Application
DEBUG=True
LOG_LEVEL=INFO
