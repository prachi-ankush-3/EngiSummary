# Base URL of your backend API. Defaults to /api (useful with a dev proxy).
VITE_API_BASE_URL=/api

# Set to "false" to use the real backend (required for real PDF processing
# AND for "Send PDF via Email" to actually work — it needs a real job_id
# that exists on the backend). While true, ALL features including email
# are simulated with mock data and no real email is ever sent.
VITE_MOCK_MODE=false
